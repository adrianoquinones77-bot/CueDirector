{
  "name": "cuedirector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "rm -rf node_modules/.vite && vite",
    "clean": "rm -rf dist dist-electron node_modules/.vite release",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/rename-electron-main.cjs",
    "preelectron": "npm run build:electron",
    "electron": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && node scripts/run-electron.cjs\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve:offline": "vite preview --host 127.0.0.1 --port 4173",
    "pack:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.cuedirector.app",
    "productName": "CueDirector",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/CueDirector.icns",
      "target": [
        "dmg",
        "dir"
      ]
    }
  }
}